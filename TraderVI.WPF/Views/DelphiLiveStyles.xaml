<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scope the dark theme to this view; the application still supplies light defaults. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="LiveSurface" Color="#1A222E"/>
    <SolidColorBrush x:Key="LiveSurfaceRaised" Color="#253245"/>
    <SolidColorBrush x:Key="LiveBorder" Color="#45566D"/>
    <SolidColorBrush x:Key="LiveText" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="LiveSecondaryText" Color="#B8C5D6"/>
    <SolidColorBrush x:Key="LiveAccent" Color="#76B5FF"/>
    <SolidColorBrush x:Key="LiveSelection" Color="#254C78"/>
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#76B5FF"/>
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#08111D"/>

    <Style x:Key="LiveFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LiveSecondaryText}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LiveAccent}"/>
        <Setter Property="Foreground" Value="#08111D"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#9DCAFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#5494DE"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#253041"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#45566D"/>
                            <Setter Property="Foreground" Value="#ABB8CA"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#111923"/>
        <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource LiveText}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource LiveSelection}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#8299B6"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#ABB8CA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Background" Value="#111923"/>
        <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource LiveSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" FontSize="14"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                                      VerticalAlignment="Center" Margin="16,0,2,0" RenderTransformOrigin="0.5,0.5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource LiveSurfaceRaised}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="6,0,6,8"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="#11151B"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource LiveSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource LiveSecondaryText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveSurfaceRaised}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveSelection}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#171D25"/>
        <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#303D4F"/>
        <Setter Property="RowBackground" Value="#171D25"/>
        <Setter Property="AlternatingRowBackground" Value="#1D2734"/>
        <Setter Property="MinRowHeight" Value="34"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#253245"/>
        <Setter Property="Foreground" Value="#DCE6F4"/>
        <Setter Property="Padding" Value="9,10"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiveBorder}"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="WrapWithOverflow" ToolTip="{Binding}"/></DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource LiveSelection}"/>
                <Setter Property="Foreground" Value="{StaticResource LiveText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

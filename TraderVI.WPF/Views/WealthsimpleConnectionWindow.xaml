<Window x:Class="TraderVI.WPF.Views.WealthsimpleConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wealthsimple connection" Width="560" Height="650" MinWidth="480" MinHeight="480"
        Background="#11151B" Foreground="#F4F7FB" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202A37"/><Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#9BAABD"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#202A37"/><Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#9BAABD"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#11151B">
    <StackPanel Margin="28">
        <TextBlock Text="Wealthsimple" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Connect your account" Foreground="#ADBBCC" Margin="0,5,0,22"/>
        <Border Background="#1A222D" BorderBrush="#344151" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="11" Height="11" Fill="{Binding IndicatorColor}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#CCD7E5" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding VerificationText}" TextWrapping="Wrap" FontSize="11" Foreground="#ADBBCC" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="TraderVI signs in directly with Wealthsimple. Your email, password and verification code are used for sign-in only."
                   TextWrapping="Wrap" Foreground="#CCD7E5" Margin="0,18,0,16"/>
        <StackPanel x:Name="CredentialsPanel" Margin="0,0,0,18">
            <Label Content="_Email" Target="{Binding ElementName=Email}" Foreground="#CCD7E5" Padding="0,0,0,6"/>
            <TextBox x:Name="Email" AutomationProperties.Name="Wealthsimple email" MaxLength="320" Margin="0,0,0,12"/>
            <Label Content="_Password" Target="{Binding ElementName=Password}" Foreground="#CCD7E5" Padding="0,0,0,6"/>
            <PasswordBox x:Name="Password" AutomationProperties.Name="Wealthsimple password" MaxLength="1024"/>
        </StackPanel>
        <StackPanel x:Name="OtpPanel" Visibility="Collapsed" Margin="0,0,0,18">
            <Label Content="_Verification code" Target="{Binding ElementName=Otp}" Foreground="#CCD7E5" Padding="0,0,0,6"/>
            <TextBox x:Name="Otp" AutomationProperties.Name="Wealthsimple verification code" MaxLength="32"/>
        </StackPanel>
        <CheckBox x:Name="Remember" Content="Keep me signed in on this Windows account" Foreground="#F4F7FB"
                  IsChecked="{Binding RememberSession, Mode=OneWay}" Click="Remember_Click" Margin="0,0,0,20">
            <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" BorderBrush="#9BAABD" BorderThickness="1" CornerRadius="3" Background="#202A37">
                            <TextBlock x:Name="Tick" Text="✓" Visibility="Hidden" Foreground="#55D68B" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </CheckBox.Template>
        </CheckBox>
        <WrapPanel>
            <Button x:Name="SignInButton" Content="Sign in" IsDefault="True" Style="{StaticResource WorkspaceButton}" Click="SignIn_Click" Margin="0,0,8,8"/>
            <Button x:Name="SubmitOtpButton" Content="Verify code" Visibility="Collapsed" Style="{StaticResource WorkspaceButton}" Click="SubmitOtp_Click" Margin="0,0,8,8"/>
            <Button x:Name="BrowserButton" Content="Continue with browser verification" Visibility="Collapsed" Style="{StaticResource WorkspaceButton}" Click="Browser_Click" Margin="0,0,8,8"/>
            <Button x:Name="CheckButton" Content="Check connection" Style="{StaticResource WorkspaceButton}" Click="Check_Click" Margin="0,0,8,8"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource WorkspaceButton}" Click="Disconnect_Click" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="Disconnect removes TraderVI’s saved session. It does not sign you out of other browsers."
                   TextWrapping="Wrap" Foreground="#ADBBCC" FontSize="11" Margin="0,10,0,0"/>
        <TextBlock x:Name="LocalMessage" TextWrapping="Wrap" Foreground="#F5B94C" Margin="0,8,0,0"/>
    </StackPanel>
    </ScrollViewer>
</Window>

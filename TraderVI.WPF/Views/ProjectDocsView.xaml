<UserControl x:Class="TraderVI.WPF.Views.ProjectDocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:TraderVI.WPF.Viewmodels"
             Background="#11151B" Foreground="#F4F7FB"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DocsPanel" Color="#1A2029"/>
        <SolidColorBrush x:Key="DocsPanelAlt" Color="#202836"/>
        <SolidColorBrush x:Key="DocsBorder" Color="#2E3949"/>
        <SolidColorBrush x:Key="DocsMuted" Color="#9BA8BA"/>
        <SolidColorBrush x:Key="DocsAccent" Color="#5FA8FF"/>
        <Style x:Key="DocsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DocsPanel}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource DocsBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141A22"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="CaretBrush" Value="#EAF0F8"/>
            <Setter Property="BorderBrush" Value="{StaticResource DocsBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#DDE6F1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type viewmodels:ProjectDocsTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                <TextBlock Text="{Binding Icon}" Foreground="{StaticResource DocsAccent}"
                           Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project Documentation" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Architecture, decisions, concepts and operating guidance"
                           Foreground="{StaticResource DocsMuted}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#173348" CornerRadius="12" Padding="12,7" Margin="0,0,12,0">
                    <TextBlock Text="READ-ONLY · LOCAL FILES · SAFE LINKS"
                               Foreground="#7EC2FF" FontWeight="SemiBold"/>
                </Border>
                <Button x:Name="RefreshButton" Content="Refresh docs" Click="RefreshButton_Click"
                        Background="{StaticResource DocsAccent}" Foreground="#08111D"
                        BorderThickness="0" Padding="18,9" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="250"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="430"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DocsCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Browse" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search titles, paths and contents…"
                                   Foreground="{StaticResource DocsMuted}" Margin="12,9"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TreeView x:Name="NavigationTree" Grid.Row="2"
                              ItemsSource="{Binding Navigation}"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <Border Grid.Column="2" Style="{StaticResource DocsCard}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource DocsPanelAlt}" Padding="18,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentPath}" Foreground="{StaticResource DocsMuted}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Foreground="{StaticResource DocsMuted}">
                                <Run Text="{Binding FilteredDocumentCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalDocumentCount, Mode=OneWay}"/><Run Text=" docs"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="DocumentViewer" Grid.Row="1"
                                              Background="Transparent" Foreground="#EAF0F8"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource DocsPanelAlt}" CornerRadius="8"
                Padding="12,8" Margin="0,14,0,0">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource DocsMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,320,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#F5B94C">
                    <Run Text="Last refresh: "/><Run Text="{Binding LastRefresh, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TraderVI.WPF.Views.ManualSellOrdersPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#1A2029" Foreground="#F4F7FB" FontFamily="Segoe UI">
 <UserControl.Resources>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#161C24"/><Setter Property="Foreground" Value="#AAB8CB"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#202836"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="MinHeight" Value="36"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#354B65"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Manual sells" FontSize="25" FontWeight="SemiBold"/>
  <TextBlock Text="Market orders · actual broker results" Foreground="#AAB8CB" Margin="0,6,0,18"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#EAC58B" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsEnabled="{Binding CanSelect}"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="110" MaxHeight="240"
   HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" RowHeight="NaN"
   Background="#202836" Foreground="#F4F7FB" RowBackground="#202836" AlternatingRowBackground="#263142" BorderBrush="#465367">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="85"/>
    <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="65"/>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="16" Margin="0,20,0,12"/>
  <Border Background="#111820" CornerRadius="6" Padding="16"><TextBlock Text="{Binding FillSummary}" TextWrapping="Wrap" LineHeight="24"/></Border>
  <Button Content="Check sell status" IsEnabled="{Binding CanCheck}" Click="Check_Click" Style="{StaticResource WorkspaceButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  <TextBlock Text="An uncertain or partial result keeps this order reserved. Checking again does not send another sell. Closing this window does not cancel an order."
   TextWrapping="Wrap" Foreground="#AAB8CB" Margin="0,16,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>

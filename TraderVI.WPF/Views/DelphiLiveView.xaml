<UserControl x:Class="TraderVI.WPF.Views.DelphiLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TraderVI.WPF.Views"
             Background="#11151B" Foreground="#F4F7FB" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DelphiLiveStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="22,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Delphi Live" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Follow Delphi's picks through the trading day." Foreground="{StaticResource LiveSecondaryText}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Setup &amp; advanced" Click="AdvancedButton_Click" VerticalAlignment="Center"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding DisplayModes}" SelectedIndex="{Binding DisplayModeIndex}" SelectionChanged="DisplayMode_SelectionChanged" Width="205" Margin="0,0,10,6"/>
            <Button Content="Refresh picks / saved state" IsEnabled="{Binding CanRefresh}" Click="RefreshButton_Click" Margin="0,0,10,6"/>
            <Button Content="{Binding ReplayButtonText}" Click="ReplayButton_Click" Margin="0,0,10,6"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="{StaticResource LiveSurface}" BorderBrush="{StaticResource LiveBorder}" BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding WatchlistSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WatchlistHelp}" Foreground="{StaticResource LiveSecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WatchlistNotice}" Foreground="#FFD58A" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,0"/>
                        <Style.Triggers><DataTrigger Binding="{Binding WatchlistNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <Grid Margin="0,12,0,0" Visibility="{Binding IsReplayMode, Converter={StaticResource VisibleIfTrue}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="Previous" IsEnabled="{Binding CanStepBack}" Click="PreviousButton_Click"/>
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Text="{Binding ReplayTime}" Foreground="{StaticResource LiveAccent}" HorizontalAlignment="Center"/>
                        <Slider Minimum="0" Maximum="{Binding ReplayFrameMaximum}" Value="{Binding ReplayFrameIndex}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Next" IsEnabled="{Binding CanStepForward}" Click="NextButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl x:Name="MainSections" Grid.Row="3" SelectionChanged="MainSections_SelectionChanged">
            <TabItem Header="Watchlist">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding WatchlistRows}" SelectedItem="{Binding SelectedWatchlistRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding Rank}" Width="55" MinWidth="55"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="80" MinWidth="80"/>
                            <DataGridTextColumn Header="Daily selection" Binding="{Binding DailySource}" Width="230" MinWidth="170"/>
                            <DataGridTextColumn Header="Since prior close" Binding="{Binding Change, StringFormat=P2}" Width="105" MinWidth="90"/>
                            <DataGridTextColumn Header="Live strength" Binding="{Binding Momentum}" Width="160" MinWidth="135"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="155" MinWidth="120"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*" MinWidth="210"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource LiveSurface}" CornerRadius="5" Padding="14,10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding WatchlistExplanation}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Replay account">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></UniformGrid.Resources>
                        <StackPanel><TextBlock Text="Starting cash" Foreground="{StaticResource LiveSecondaryText}"/><TextBlock Text="{Binding ReplayCapitalText}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Cash at this time" Foreground="{StaticResource LiveSecondaryText}"/><TextBlock Text="{Binding ReplayCashText}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Estimated account value" Foreground="{StaticResource LiveSecondaryText}"/><TextBlock Text="{Binding ReplayValueText}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Estimated total profit / loss" Foreground="{StaticResource LiveSecondaryText}"/><TextBlock Text="{Binding ReplayProfitText}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Grid.Row="1" Text="{Binding ReplayCoverageText}" Foreground="{StaticResource LiveSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Trades at this time">
                            <DataGrid ItemsSource="{Binding ReplayTrades}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="85"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Side}" Width="65"/>
                                <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="95"/>
                                <DataGridTextColumn Header="Estimated fill" Binding="{Binding Filled}" Width="110"/>
                                <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="85"/>
                                <DataGridTextColumn Header="Realized P/L" Binding="{Binding RealizedProfit, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*" MinWidth="190"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="220"/>
                            </DataGrid.Columns></DataGrid>
                        </TabItem>
                        <TabItem Header="Holdings at this time">
                            <DataGrid ItemsSource="{Binding ReplayPositions}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="100"/>
                                <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="Average cost" Binding="{Binding AverageCost, StringFormat=N2}" Width="130"/>
                                <DataGridTextColumn Header="Checkpoint price" Binding="{Binding Mark, StringFormat=N2}" Width="145"/>
                                <DataGridTextColumn Header="Unrealized P/L" Binding="{Binding UnrealizedProfit, StringFormat=N2}" Width="150"/>
                            </DataGrid.Columns></DataGrid>
                        </TabItem>
                    </TabControl>
                    <Expander Grid.Row="3" Header="How the historical estimates work" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ReplayAssumptions}" TextWrapping="Wrap" Foreground="{StaticResource LiveSecondaryText}" Margin="10"/>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="Advanced"><views:DelphiLiveAdvancedView/></TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="TraderVI.WPF.Views.PortfoliosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11151B" Foreground="#F4F7FB">
    <UserControl.Resources>
        <!-- The view is constructed before it joins PaperDashboardWindow's resource tree,
             so every resource needed during XAML parsing must be local. -->
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202836"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E3949"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA8BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5FA8FF"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F5B94C"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#171D25"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08111D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="1.35*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Portfolios" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Total TFSA value" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBox Grid.Column="3" Text="{Binding TotalTfsaValue, UpdateSourceTrigger=PropertyChanged}"
                     Margin="7,0,14,0" Padding="7,5" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Available cash" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBox Grid.Column="5" Text="{Binding AvailableTfsaCash, UpdateSourceTrigger=PropertyChanged}"
                     Margin="7,0,14,0" Padding="7,5" VerticalContentAlignment="Center"/>
            <Button x:Name="StartButton" Grid.Column="6" Content="Start Shadow V1" Click="StartButton_Click"
                    IsEnabled="{Binding CanStart}" Margin="0,0,8,0" Padding="14,7"/>
            <Button x:Name="SnapshotButton" Grid.Column="7" Content="Record real snapshot" Click="SnapshotButton_Click"
                    IsEnabled="{Binding CanRecordSnapshot}" Background="#77C7FF" Margin="0,0,8,0" Padding="14,7"/>
            <Button x:Name="PauseButton" Grid.Column="8" Content="Pause new buys" Click="PauseButton_Click"
                    IsEnabled="{Binding CanPause}" Background="{StaticResource WarningBrush}" Margin="0,0,8,0" Padding="14,7"/>
            <Button x:Name="ResumeButton" Grid.Column="9" Content="Resume" Click="ResumeButton_Click"
                    IsEnabled="{Binding CanResume}" Padding="14,7"/>
            <Button x:Name="RefreshButton" Grid.Column="11" Content="Refresh from SQL" Click="RefreshButton_Click"
                    Margin="12,0,0,0" Padding="14,7" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="12" Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Real comparison, operator ghosts, and four independent System Shadow alternatives"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding GenerationStatus}" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Portfolio overview" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Portfolios}" SelectedItem="{Binding SelectedPortfolio}"
                          SelectionChanged="PortfoliosGrid_SelectionChanged" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Portfolio" Binding="{Binding DisplayName}" Width="2*" MinWidth="210"/>
                        <DataGridTextColumn Header="Selector" Binding="{Binding Selector}" Width="75"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding Execution}" Width="65"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135"/>
                        <DataGridTextColumn Header="NAV" Binding="{Binding NetAssetValue, StringFormat={}{0:C2}}" Width="100"/>
                        <DataGridTextColumn Header="Cash" Binding="{Binding Cash, StringFormat={}{0:C2}}" Width="95"/>
                        <DataGridTextColumn Header="Open" Binding="{Binding OpenPositions}" Width="52"/>
                        <DataGridTextColumn Header="Realized" Binding="{Binding RealizedProfitLoss, StringFormat={}{0:C2}}" Width="90"/>
                        <DataGridTextColumn Header="Unrealized" Binding="{Binding UnrealizedProfitLoss, StringFormat={}{0:C2}}" Width="95"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalReturn, StringFormat={}{0:P2}}" Width="72"/>
                        <DataGridTextColumn Header="Today" Binding="{Binding DailyReturn, StringFormat={}{0:P2}}" Width="72"/>
                        <DataGridTextColumn Header="Drawdown" Binding="{Binding Drawdown, StringFormat={}{0:P2}}" Width="85"/>
                        <DataGridTextColumn Header="Freshness" Binding="{Binding FreshnessText}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Candidate monitor" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PortfolioDisplayName}" Foreground="{StaticResource AccentBrush}" Margin="12,3,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Rechecked every Shadow poll · a blocked candidate may qualify later"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="52"/>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="72"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="82"/>
                        <DataGridTextColumn Header="Yesterday" Binding="{Binding PreviousSessionClose, StringFormat={}{0:C3}}" Width="92"/>
                        <DataGridTextColumn Header="Prior 5m" Binding="{Binding PreviousFiveMinuteClose, StringFormat={}{0:C3}}" Width="88"/>
                        <DataGridTextColumn Header="Latest 5m" Binding="{Binding LatestFiveMinuteClose, StringFormat={}{0:C3}}" Width="92"/>
                        <DataGridTextColumn Header="vs yesterday" Binding="{Binding PercentVsPreviousSession, StringFormat={}{0:P2}}" Width="96"/>
                        <DataGridTextColumn Header="Bar end" Binding="{Binding LatestBarText}" Width="76"/>
                        <DataGridTextColumn Header="Decision" Binding="{Binding ReasonText}" Width="*" MinWidth="240"/>
                        <DataGridTextColumn Header="Evaluated" Binding="{Binding LastEvaluatedText}" Width="92"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="System holdings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <TextBox Width="220" Padding="6,3" Text="{Binding PortfolioDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Rename" Padding="10,4" Margin="8,0,0,0" IsEnabled="{Binding CanRename}" Click="RenameButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Holdings}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="65"/>
                            <DataGridTextColumn Header="Shares" Binding="{Binding Shares}" Width="60"/>
                            <DataGridTextColumn Header="Avg cost" Binding="{Binding AverageCost, StringFormat={}{0:C3}}" Width="85"/>
                            <DataGridTextColumn Header="Last" Binding="{Binding LastPrice, StringFormat={}{0:C3}}" Width="80"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding MarketValue, StringFormat={}{0:C2}}" Width="90"/>
                            <DataGridTextColumn Header="P/L" Binding="{Binding ProfitLoss, StringFormat={}{0:C2}}" Width="80"/>
                            <DataGridTextColumn Header="Trail" Binding="{Binding TrailingStop, StringFormat={}{0:C3}}" Width="80"/>
                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Decisions and audit" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="90"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="145"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12,8">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,350,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}"
                           Text="virtual whole shares · 0.25% friction each side · no broker"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:TraderVI.WPF.Views">
    <SolidColorBrush x:Key="WorkspaceSurface" Color="#1A222D"/>
    <SolidColorBrush x:Key="WorkspaceMuted" Color="#ADBBCC"/>
    <Style x:Key="WorkspacePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WorkspaceSurface}"/><Setter Property="BorderBrush" Value="#344151"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="WorkspaceLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorkspaceMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="WorkspaceTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="WorkspaceButton" TargetType="Button">
        <Setter Property="Background" Value="#263548"/><Setter Property="Foreground" Value="#E8EEF6"/>
        <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderBrush="#5C7697" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#354B65"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#DCEBFF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9BAABD"/><Setter TargetName="Chrome" Property="Background" Value="#202A37"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkspaceNavItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="#ADBBCC"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" CornerRadius="5" Margin="8,3" Padding="10,11" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{TemplateBinding views:WorkspaceNavigationState.Icon}"
                               FontFamily="Segoe MDL2 Assets" FontSize="17" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="NavLabel" ContentSource="Header" RecognizesAccessKey="True" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border><ControlTemplate.Triggers>
                <Trigger Property="views:WorkspaceNavigationState.IsCollapsed" Value="True">
                    <Setter TargetName="NavLabel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Chrome" Property="Margin" Value="6,3"/>
                    <Setter TargetName="Chrome" Property="Padding" Value="7,11"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#9BC9FF"/><Setter TargetName="Chrome" Property="Background" Value="#253B55"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#506784"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkspaceMenuToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#ADBBCC"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Collapse side menu"/>
        <Setter Property="AutomationProperties.Name" Value="Collapse side menu"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                <TextBlock x:Name="Glyph" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="&#xE700;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#253B55"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsChecked" Value="True">
            <Setter Property="ToolTip" Value="Expand side menu"/><Setter Property="AutomationProperties.Name" Value="Expand side menu"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WorkspaceNavigation" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/><Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceNavItem}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#171E27" BorderBrush="#344151" BorderThickness="0,0,1,0"><DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Brand" Text="TraderVI" FontSize="23" Foreground="#E8EEF6" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="NavigationToggle" Grid.Column="1" Style="{StaticResource WorkspaceMenuToggle}" Margin="0,0,10,0"
                                          IsChecked="{Binding Path={x:Static views:WorkspaceNavigationState.IsCollapsedBindingPath}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock x:Name="Tagline" Text="TSX · Trading workspace" Foreground="#ADBBCC" FontSize="11" Margin="16,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="WealthsimpleStatus" DockPanel.Dock="Bottom" Margin="8,12" Padding="8,14"
                            Style="{StaticResource WorkspaceButton}" HorizontalContentAlignment="Left"
                            Command="{x:Static views:WorkspaceNavigationState.OpenWealthsimple}"
                            DataContext="{TemplateBinding views:WorkspaceNavigationState.Connection}"
                            ToolTip="{Binding AccessibleStatus}" AutomationProperties.Name="{Binding AccessibleStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding IndicatorColor, FallbackValue=#FF747D}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="WealthsimpleLabel" Margin="9,0,0,0">
                                <TextBlock Text="Wealthsimple" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status, FallbackValue=Disconnected}" FontSize="10" Foreground="#ADBBCC" MaxWidth="112" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </DockPanel></Border>
                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="0"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="views:WorkspaceNavigationState.IsCollapsed" Value="True">
                <Setter TargetName="NavigationColumn" Property="Width" Value="56"/>
                <Setter TargetName="Brand" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Tagline" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="WealthsimpleLabel" Property="Visibility" Value="Collapsed"/>
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>

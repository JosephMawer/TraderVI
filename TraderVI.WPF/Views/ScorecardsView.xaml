<UserControl x:Class="TraderVI.WPF.Views.ScorecardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11151B" Foreground="#F4F7FB">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ScorePanel" Color="#1A2029"/>
        <SolidColorBrush x:Key="ScoreBorder" Color="#2E3949"/>
        <SolidColorBrush x:Key="ScoreMuted" Color="#9BA8BA"/>
        <Style x:Key="ScoreCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ScorePanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScoreBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style x:Key="ScoreLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ScoreMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ScoreValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#D8E1EC"/>
            <Setter Property="Background" Value="#202836"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Official Delphi Prediction Scorecards" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Model calibration, lens ranking, and diagnostics · official predictions only"
                           Foreground="{StaticResource ScoreMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshScorecardsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh from SQL" Click="RefreshScorecardsButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ScoreCard}"><StackPanel><TextBlock Style="{StaticResource ScoreLabel}" Text="REPORT STATE"/><TextBlock Style="{StaticResource ScoreValue}" Text="{Binding CoverageState}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource ScoreCard}"><StackPanel><TextBlock Style="{StaticResource ScoreLabel}" Text="USABLE COVERAGE"/><TextBlock Style="{StaticResource ScoreValue}" Text="{Binding UsableCoverage}"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource ScoreCard}"><StackPanel><TextBlock Style="{StaticResource ScoreLabel}" Text="INDEPENDENT COHORTS"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding CohortCount}"/></StackPanel></Border>
            <Border Grid.Column="6" Style="{StaticResource ScoreCard}"><StackPanel><TextBlock Style="{StaticResource ScoreLabel}" Text="OFFICIAL OUTCOMES"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding CandidateCount}"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Background="#202836" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
            <TextBlock Text="{Binding ReadinessExplanation}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="3" Background="Transparent" BorderBrush="{StaticResource ScoreBorder}">
            <TabItem Header="Models">
                <DataGrid ItemsSource="{Binding Models}" Margin="8" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Probability coverage" Binding="{Binding Coverage}" Width="145"/>
                        <DataGridTextColumn Header="Cohorts" Binding="{Binding Cohorts}" Width="75"/>
                        <DataGridTextColumn Header="Brier ↓" Binding="{Binding Brier}" Width="90"/>
                        <DataGridTextColumn Header="AUC ↑" Binding="{Binding Auc}" Width="90"/>
                        <DataGridTextColumn Header="ECE ↓" Binding="{Binding Ece}" Width="90"/>
                        <DataGridTextColumn Header="Top-decile lift ↑" Binding="{Binding TopDecileLift}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Reliability">
                <DataGrid ItemsSource="{Binding Reliability}" Margin="8" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Probability bucket" Binding="{Binding ProbabilityRange}" Width="145"/>
                        <DataGridTextColumn Header="Observations" Binding="{Binding Observations}" Width="105"/>
                        <DataGridTextColumn Header="Cohorts" Binding="{Binding Cohorts}" Width="80"/>
                        <DataGridTextColumn Header="Mean prediction" Binding="{Binding MeanProbability}" Width="130"/>
                        <DataGridTextColumn Header="Observed rate" Binding="{Binding ObservedRate}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Deciles">
                <DataGrid ItemsSource="{Binding Deciles}" Margin="8" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Decile" Binding="{Binding Decile}" Width="70"/>
                        <DataGridTextColumn Header="Observations" Binding="{Binding Observations}" Width="105"/>
                        <DataGridTextColumn Header="Cohorts" Binding="{Binding Cohorts}" Width="80"/>
                        <DataGridTextColumn Header="Mean prediction" Binding="{Binding MeanProbability}" Width="130"/>
                        <DataGridTextColumn Header="Event rate" Binding="{Binding EventRate}" Width="105"/>
                        <DataGridTextColumn Header="Lift vs run" Binding="{Binding Lift}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Lenses">
                <DataGrid ItemsSource="{Binding Lenses}" Margin="8" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lens" Binding="{Binding Lens}" Width="110"/>
                        <DataGridTextColumn Header="Eligible" Binding="{Binding Eligible}" Width="75"/>
                        <DataGridTextColumn Header="Cohorts" Binding="{Binding Cohorts}" Width="75"/>
                        <DataGridTextColumn Header="Rank IC ↑" Binding="{Binding RankIc}" Width="90"/>
                        <DataGridTextColumn Header="Selection" Binding="{Binding Selection}" Width="105"/>
                        <DataGridTextColumn Header="Return 10" Binding="{Binding MeanReturn}" Width="100"/>
                        <DataGridTextColumn Header="Excess 10" Binding="{Binding ExcessReturn}" Width="100"/>
                        <DataGridTextColumn Header="Lift ↑" Binding="{Binding Lift}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <DataGrid ItemsSource="{Binding Slices}" Margin="8" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" Width="125"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="N" Binding="{Binding Observations}" Width="50"/>
                        <DataGridTextColumn Header="Cohorts" Binding="{Binding Cohorts}" Width="70"/>
                        <DataGridTextColumn Header="Return 10" Binding="{Binding Return10}" Width="90"/>
                        <DataGridTextColumn Header="Excess 10" Binding="{Binding Excess10}" Width="90"/>
                        <DataGridTextColumn Header="Up" Binding="{Binding UpRate}" Width="70"/>
                        <DataGridTextColumn Header="Down" Binding="{Binding DownRate}" Width="70"/>
                        <DataGridTextColumn Header="Breakout" Binding="{Binding BreakoutRate}" Width="80"/>
                        <DataGridTextColumn Header="Vol expansion" Binding="{Binding VolExpansionRate}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="#202836" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,330,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#F5B94C" Text="Read-only evidence · no tuning · no trade action"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

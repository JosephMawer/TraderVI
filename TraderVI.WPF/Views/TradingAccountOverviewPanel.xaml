<UserControl x:Class="TraderVI.WPF.Views.TradingAccountOverviewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#E8EEF6">
 <StackPanel>
  <Border Style="{StaticResource WorkspacePanel}">
   <StackPanel>
    <WrapPanel><TextBlock Text="{Binding Account, TargetNullValue=Main account}" FontSize="23" FontWeight="SemiBold" Margin="0,0,16,0"/><TextBlock Text="REAL · OPERATOR REPORTED" Style="{StaticResource WorkspaceLabel}" VerticalAlignment="Center"/></WrapPanel>
    <TextBlock Text="Total account gain · CAD" Style="{StaticResource WorkspaceLabel}" Margin="0,20,0,2"/>
    <TextBlock Text="Not available" FontSize="32" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding TotalGainExplanation, TargetNullValue=Load the account to read its saved financial facts.}" Style="{StaticResource WorkspaceLabel}"/>
    <UniformGrid Columns="3" Margin="0,22,0,16">
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Reported account value" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding ReportedValue, StringFormat={}{0:N2} CAD, TargetNullValue=—}" FontSize="22" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Reported cash" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding ReportedCash, StringFormat={}{0:N2} CAD, TargetNullValue=—}" FontSize="22" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="Recorded holdings value" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding HoldingsValue, StringFormat={}{0:N2} CAD, TargetNullValue=—}" FontSize="22" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="{Binding ReportContext}" Style="{StaticResource WorkspaceLabel}"/>
    <TextBlock Text="Saved holding prices are not a synchronized account balance. Position update times are shown below." Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,0"/>
    <UniformGrid Columns="2" Margin="0,20,0,0">
     <StackPanel Margin="0,0,16,0"><TextBlock Text="Recorded sale gain · last 30 calendar days" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding RecordedSaleGain, StringFormat='{}{0:+#,##0.00;-#,##0.00;0.00} CAD', TargetNullValue=Unavailable}" FontSize="21" Margin="0,5,0,0"/><TextBlock Text="{Binding SaleGainContext}" Style="{StaticResource WorkspaceLabel}" Margin="0,5,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="Open-position gain · unrealized" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding OpenGain, StringFormat='{}{0:+#,##0.00;-#,##0.00;0.00} CAD', TargetNullValue=Unavailable}" FontSize="21" Margin="0,5,0,0"/><TextBlock Text="Only recorded open holdings, using their saved prices." Style="{StaticResource WorkspaceLabel}" Margin="0,5,0,0"/></StackPanel>
    </UniformGrid>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource WorkspacePanel}" Margin="0,14,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,14,0"><TextBlock Text="ACTIVE MAIN STRATEGY" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding Strategy, TargetNullValue=No account loaded}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding StrategySince}" Style="{StaticResource WorkspaceLabel}"/></StackPanel>
    <Button Grid.Column="1" Content="Compare / change strategy…" Style="{StaticResource WorkspaceButton}" Click="Portfolios_Click" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid Margin="0,22,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Your recorded holdings" FontSize="20" FontWeight="SemiBold"/>
   <StackPanel Grid.Column="1"><TextBlock Text="Open-position gain · unrealized" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding OpenGain, StringFormat='{}{0:+#,##0.00;-#,##0.00;0.00} CAD', TargetNullValue=Unavailable}" FontSize="18" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
  <DataGrid ItemsSource="{Binding Holdings}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="85" MaxHeight="260" HorizontalScrollBarVisibility="Auto" RowHeight="NaN">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="75"/>
    <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="60"/>
    <DataGridTextColumn Header="Value · CAD" Binding="{Binding Value,StringFormat=N2,TargetNullValue=—}" Width="100"/>
    <DataGridTextColumn Header="Open gain · CAD" Binding="{Binding Gain,StringFormat=N2,TargetNullValue=—}" Width="110"/>
    <DataGridTemplateColumn Header="Strategy decision" Width="*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Decision}" TextWrapping="Wrap" Margin="8"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Position updated" Binding="{Binding ValuedAt}" Width="210"/>
    <DataGridTextColumn Header="Decision evidence" Binding="{Binding DecisionAt}" Width="210"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="No recorded holdings in this account." Margin="0,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Holdings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <WrapPanel Margin="0,8,0,14"><Button Content="Recorded trades / reconcile holdings" Style="{StaticResource WorkspaceButton}" Click="Monitor_Click"/><TextBlock Text="TraderVI records · recommendations only" Style="{StaticResource WorkspaceLabel}" Margin="12,8,0,0"/></WrapPanel>
 </StackPanel>
</UserControl>

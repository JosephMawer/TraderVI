<UserControl x:Class="TraderVI.WPF.Views.ManualBuyTicketPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#1A2029" Foreground="#F4F7FB" FontFamily="Segoe UI">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAB8CB"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource WorkspaceButton}"><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#2A3443"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#465367"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11151B"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#465367"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#202836"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Padding" Value="10"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="#465367" BorderThickness="1" CornerRadius="4"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,28,8" VerticalAlignment="Center" IsHitTestVisible="False"/></Border>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="▾" Foreground="#AAB8CB" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#202836" BorderBrush="#465367" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#2A3443"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#202836"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#354B65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AAB8CB"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,3"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#F4F7FB"/><Setter TargetName="Tab" Property="Background" Value="#292137"/><Setter TargetName="Tab" Property="BorderBrush" Value="#B58CFF"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#F4F7FB"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate>
  </Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#161C24"/><Setter Property="Foreground" Value="#AAB8CB"/><Setter Property="Padding" Value="6,8"/><Setter Property="BorderBrush" Value="#354154"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#202836"/><Setter Property="Foreground" Value="#F4F7FB"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#354154"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="22">
  <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="Wealthsimple · self-directed TFSA · manual orders" Style="{StaticResource Muted}" Margin="0,4,0,16"/>
  <Button Content="Wealthsimple connection…" Click="Connection_Click" HorizontalAlignment="Left" Margin="0,0,0,12" IsEnabled="{Binding CanEditOrders}"/>
  <TabControl x:Name="Sections" Background="Transparent" BorderThickness="0">
   <TabItem Header="Buy" Visibility="{Binding HasBuy, Converter={StaticResource BoolVisibility}}">
    <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="Account" Style="{StaticResource Muted}"/>
     <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectAccount}" Margin="0,5,0,12"/>
     <TextBlock Text="{Binding InstrumentText}" Margin="0,0,0,16"/>
     <TextBlock Text="Shares" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="Enter any positive whole number. Ten-share shortcuts are optional." Style="{StaticResource Muted}" Margin="0,3,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SharesInput" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" AutomationProperties.Name="Share quantity" MaxLength="10"/>
      <Button Grid.Column="1" Content="−10" Click="Minus_Click" Margin="8,0,0,0" AutomationProperties.Name="Decrease share quantity by ten"/>
      <Button Grid.Column="2" Content="+10" Click="Plus_Click" Margin="8,0,0,0" AutomationProperties.Name="Increase share quantity by ten"/>
     </Grid>
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Reference ask" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding AskText}" Margin="10,0,0,9"/>
      <TextBlock Grid.Row="1" Text="Estimated cost" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstimateText}" FontSize="23" FontWeight="SemiBold" Margin="10,0,0,9"/>
      <TextBlock Grid.Row="2" Text="Available cash / buying power" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuyingPowerText}" Margin="10,0,0,9"/>
      <TextBlock Grid.Row="3" Text="Shares already held" Style="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HeldQuantityText}" Margin="10,0,0,0"/>
     </Grid>
     <TextBlock Text="{Binding QuoteTimeText}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
     <TextBlock Text="Market price can change. The actual fill price and total cost are not capped." Foreground="#F5C579" Margin="0,14,0,0"/>
     <Separator Margin="0,14" Background="#354154"/>
     <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ManualNotice}" Margin="0,7,0,14"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Orders" x:Name="OrdersTab">
    <StackPanel Margin="0,16,0,0">
     <TextBlock Text="Manual orders saved on this Windows account" Style="{StaticResource Muted}" Margin="0,0,0,9"/>
     <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsEnabled="{Binding CanEditOrders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="100" MaxHeight="230" Background="#11151B" Foreground="#F4F7FB" RowBackground="#1A2029" AlternatingRowBackground="#202836" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#354154" BorderBrush="#354154">
      <DataGrid.Columns><DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="85"/><DataGridTextColumn Header="Shares" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Filled" Binding="{Binding Filled}" Width="60"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="170"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{Binding OrderSummary}" Margin="0,16,0,10" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding FillSummary}" Margin="0,0,0,14"/>
     <TextBlock Text="Broker-confirmed results belong to manual orders. Automatic selling and strategy attribution are not assigned. Closing the ticket does not cancel an order." Style="{StaticResource Muted}"/>
     <WrapPanel Margin="0,14,0,0"><Button Content="Check order status" Click="Check_Click" IsEnabled="{Binding CanCheckOrder}"/><Button Content="New manual buy…" Click="New_Click" IsEnabled="{Binding CanStartNew}" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
   </TabItem>
  </TabControl>
  <TextBlock Text="{Binding Status}" Foreground="#C6D1E2" Margin="0,16,0,7" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding Validation}" Foreground="#F5C579" Margin="0,0,0,12"/>
  <WrapPanel>
   <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Sections}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
   <Button Content="Refresh checks" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,8,8"/>
   <Button Content="{Binding SubmitText}" Click="Submit_Click" IsEnabled="{Binding CanSubmit}" Background="#B58CFF" Foreground="#160C28" FontWeight="SemiBold" Margin="0,0,0,8"/>
  </WrapPanel>
 </StackPanel>
 </ScrollViewer>
</UserControl>

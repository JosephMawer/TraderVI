<UserControl x:Class="TraderVI.WPF.Views.TradingRecommendationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:TraderVI.WPF.Services" xmlns:views="clr-namespace:TraderVI.WPF.Views" Background="#11151B" Foreground="#F4F7FB">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <StackPanel x:Name="BrokerTools">
   <Expander Header="Broker status &amp; orders" Foreground="#E8EEF6" IsExpanded="True"><StackPanel Margin="0,8">
    <TextBlock Text="{Binding TradeSyncStatus}" Style="{StaticResource WorkspaceLabel}"/>
    <TextBlock Text="{Binding OrdersStatus}" Style="{StaticResource WorkspaceLabel}" Margin="0,8,0,8"/>
   <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="65" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Stock" Binding="{Binding Symbol}" Width="85"/><DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="65"/><DataGridTextColumn Header="Submitted shares" Binding="{Binding Quantity, StringFormat=0.########}" Width="145"/><DataGridTextColumn Header="Limit" Binding="{Binding LimitPrice}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
   </StackPanel></Expander>
   <Expander Header="Manual orders" Foreground="#E8EEF6" Margin="0,10,0,0"><WrapPanel Margin="0,10">
    <Button Content="Manual buys…" Command="{x:Static views:ManualBuyCommands.Orders}" Style="{StaticResource WorkspaceButton}" Margin="0,0,10,0"/>
    <Button Content="Manual sells…" Command="{x:Static views:ManualSellCommands.Orders}" Style="{StaticResource WorkspaceButton}"/>
   </WrapPanel></Expander>
   <Expander Header="Reconcile &amp; import" Foreground="#E8EEF6" Margin="0,10,0,0"><StackPanel Margin="0,10">
    <TextBlock Text="Reconcile to compare broker history with current holdings. Import can save verified history to the linked TraderVI ledger." Style="{StaticResource WorkspaceLabel}" Margin="0,0,0,8"/>
    <WrapPanel><Button Content="Reconcile account…" Command="{x:Static views:BrokerReconciliationCommands.Refresh}" CommandParameter="{Binding SelectedAccount}" Style="{StaticResource WorkspaceButton}" Margin="0,0,10,0"/>
     <Button Content="Import account history…" Command="{x:Static views:BrokerImportCommands.Open}" CommandParameter="{Binding SelectedAccount}" Style="{StaticResource WorkspaceButton}"/>
    </WrapPanel>
   </StackPanel></Expander>
   <Expander Header="Managed TFSA buying controls" Foreground="#E8EEF6" Margin="0,10,0,0">
   <StackPanel DataContext="{Binding ManagedStrategy}" Margin="0,10"><TextBlock Text="{Binding BuyingMode}"/><TextBlock Text="{Binding Duration}" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding Status}" Style="{StaticResource WorkspaceLabel}" Margin="0,5,0,0"/>
    <WrapPanel Margin="0,8"><Button Content="Stop new buys" IsEnabled="{Binding CanStopBuying}" Click="StopBuying_Click" Style="{StaticResource WorkspaceButton}" Margin="0,0,10,0"/><Button Content="Resume buying" IsEnabled="{Binding CanResumeBuying}" Click="ResumeBuying_Click" Style="{StaticResource WorkspaceButton}"/></WrapPanel>
   </StackPanel>
   </Expander>
   <Expander Header="Advanced setup" Foreground="#E8EEF6" Margin="0,10,0,0">
    <Button Content="Account risk setup…" Command="{x:Static services:BrokerRiskSetupCommands.Open}" CommandParameter="{Binding SelectedAccount}" Style="{StaticResource WorkspaceButton}" HorizontalAlignment="Left" Margin="0,10"/>
   </Expander>
  </StackPanel>
  <Expander Header="TraderVI records and recommendation tools" Foreground="#F4F7FB" Margin="0,20,0,0"><StackPanel Margin="0,10">
  <WrapPanel Margin="0,12"><TextBlock Text="Real account" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox x:Name="Account" Text="TFSA" Width="160" MaxLength="64"/>
   <Button Content="Load account" Click="Refresh_Click" Margin="10,0"/>
  </WrapPanel>
  <Expander Header="TraderVI recorded account, holdings and active strategy" Foreground="#F4F7FB" Margin="0,14" IsExpanded="False">
   <views:TradingAccountOverviewPanel x:Name="OverviewPanel" Margin="0,10,0,0"/>
  </Expander>
  <TextBlock Text="Recommendations for this account" FontSize="20" FontWeight="SemiBold" Margin="0,10"/>
  <TextBlock Text="Advice from the approved strategy. Only a reported completed fill changes your holdings." Style="{StaticResource WorkspaceLabel}" Margin="0,0,0,10"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#F5CB83" Margin="0,0,0,12"/>
  <DataGrid x:Name="Recommendations" Height="220" AutoGenerateColumns="False" IsReadOnly="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}"/>
    <DataGridTextColumn Header="Action" Binding="{Binding Action}"/>
    <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}"/>
    <DataGridTextColumn Header="Reference price" Binding="{Binding ReferencePrice,StringFormat=F3}"/>
    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
    <DataGridTextColumn Header="Evidence UTC" Binding="{Binding EvidenceUtc,StringFormat=yyyy-MM-dd HH:mm:ss}"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Margin="0,10"><Button Content="Evaluate approved strategy" Click="Evaluate_Click" Margin="0,0,10,8"/><Button Content="Report actual purchase…" Click="Buy_Click" Margin="0,0,10,8"/><Button Content="Report actual sale…" Click="Sell_Click" Margin="0,0,0,8"/></WrapPanel>
  <Expander Header="Active strategy details" Foreground="#F4F7FB" Margin="0,10"><StackPanel Margin="12"><TextBlock x:Name="Source" Text="Load the account to read its approved source." TextWrapping="Wrap"/></StackPanel></Expander>
  <Expander Header="Report current account state" Foreground="#F4F7FB" Margin="0,10">
   <StackPanel>
    <TextBlock Text="Reconcile holdings in Tracked holdings first, then confirm these current CAD values and outstanding orders. Report again each session and after any fill or external cash change." TextWrapping="Wrap" Margin="0,10"/>
    <TextBlock x:Name="HoldingsText" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,10">
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Available cash"/><TextBox x:Name="Cash" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Account value"/><TextBox x:Name="Nav" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Session opening value"/><TextBox x:Name="Opening" Width="150"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Highest closing value"/><TextBox x:Name="High" Width="150"/></StackPanel>
     <StackPanel><TextBlock Text="Outstanding orders"/><TextBox x:Name="Pending" Width="140"/></StackPanel>
    </WrapPanel>
    <Button Content="Confirm these reported account facts" Click="Report_Click" HorizontalAlignment="Left"/>
    <Button Content="Review capital hold and rebase closing high…" Click="Capital_Click" HorizontalAlignment="Left" Margin="0,10"/>
   </StackPanel>
  </Expander>
  <Expander Header="Approval history and switching back" Foreground="#F4F7FB" Margin="0,10">
   <StackPanel><TextBlock Text="Each switch appends a new approval. Select an earlier approval to review its exact saved strategy again." TextWrapping="Wrap" Margin="0,10"/>
    <DataGrid x:Name="History" Height="180" IsReadOnly="True" AutoGenerateColumns="False">
     <DataGrid.Columns><DataGridTextColumn Header="Effective UTC" Binding="{Binding EffectiveUtc}"/><DataGridTextColumn Header="Strategy" Binding="{Binding Strategy.Name}" Width="*"/><DataGridTextColumn Header="Reviewer" Binding="{Binding Reviewer}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns>
    </DataGrid><Button Content="Review selected strategy again…" Click="Previous_Click" HorizontalAlignment="Left" Margin="0,10"/>
   </StackPanel>
  </Expander>
  </StackPanel></Expander>
 </StackPanel></ScrollViewer>
</UserControl>

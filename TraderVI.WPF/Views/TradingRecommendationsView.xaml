<UserControl x:Class="TraderVI.WPF.Views.TradingRecommendationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:TraderVI.WPF.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="Trading recommendations" FontSize="26" FontWeight="SemiBold"/>
  <WrapPanel Margin="0,12"><TextBlock Text="Real account" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox x:Name="Account" Text="TFSA" Width="160" MaxLength="64"/>
   <Button Content="Load account" Click="Refresh_Click" Margin="10,0"/>
   <Button Content="Evaluate approved strategy" Click="Evaluate_Click"/>
  </WrapPanel>
  <TextBlock x:Name="Source" Text="Load the account to read its approved source." TextWrapping="Wrap" FontSize="18"/>
  <TextBlock Text="Recommendations are advice. Quantities use reported Real cash and holdings; only a separately reported completed fill changes holdings. No broker orders are sent." TextWrapping="Wrap" Margin="0,10"/>
  <views:SystemControlBar SystemKey="TrackedPositions"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#F5CB83" Margin="0,12"/>
  <DataGrid x:Name="Recommendations" Height="220" AutoGenerateColumns="False" IsReadOnly="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}"/>
    <DataGridTextColumn Header="Action" Binding="{Binding Action}"/>
    <DataGridTextColumn Header="Shares" Binding="{Binding Quantity}"/>
    <DataGridTextColumn Header="Reference price" Binding="{Binding ReferencePrice,StringFormat=F3}"/>
    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
    <DataGridTextColumn Header="Evidence UTC" Binding="{Binding EvidenceUtc,StringFormat=yyyy-MM-dd HH:mm:ss}"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Margin="0,10"><Button Content="Report actual purchase…" Click="Buy_Click"/><Button Content="Report actual sale…" Click="Sell_Click" Margin="10,0"/></WrapPanel>
  <Expander Header="Report current account state" IsExpanded="True" Foreground="#F4F7FB" Margin="0,10">
   <StackPanel>
    <TextBlock Text="Reconcile holdings in Tracked holdings first, then confirm these current CAD values and outstanding orders. Report again each session and after any fill or external cash change." TextWrapping="Wrap" Margin="0,10"/>
    <TextBlock x:Name="HoldingsText" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,10">
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Available cash"/><TextBox x:Name="Cash" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Account value"/><TextBox x:Name="Nav" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Session opening value"/><TextBox x:Name="Opening" Width="150"/></StackPanel>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="Highest closing value"/><TextBox x:Name="High" Width="150"/></StackPanel>
     <StackPanel><TextBlock Text="Outstanding orders"/><TextBox x:Name="Pending" Width="140"/></StackPanel>
    </WrapPanel>
    <Button Content="Confirm these reported account facts" Click="Report_Click" HorizontalAlignment="Left"/>
    <Button Content="Review capital hold and rebase closing high…" Click="Capital_Click" HorizontalAlignment="Left" Margin="0,10"/>
   </StackPanel>
  </Expander>
  <Expander Header="Approval history and switching back" Foreground="#F4F7FB" Margin="0,10">
   <StackPanel><TextBlock Text="Each switch appends a new approval. Select an earlier approval to review its exact saved strategy again." TextWrapping="Wrap" Margin="0,10"/>
    <DataGrid x:Name="History" Height="180" IsReadOnly="True" AutoGenerateColumns="False">
     <DataGrid.Columns><DataGridTextColumn Header="Effective UTC" Binding="{Binding EffectiveUtc}"/><DataGridTextColumn Header="Strategy" Binding="{Binding Strategy.Name}" Width="*"/><DataGridTextColumn Header="Reviewer" Binding="{Binding Reviewer}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns>
    </DataGrid><Button Content="Review selected strategy again…" Click="Previous_Click" HorizontalAlignment="Left" Margin="0,10"/>
   </StackPanel>
  </Expander>
 </StackPanel></ScrollViewer>
</UserControl>

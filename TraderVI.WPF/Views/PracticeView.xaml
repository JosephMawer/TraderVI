<UserControl x:Class="TraderVI.WPF.Views.PracticeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Unloaded="View_Unloaded">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Border Background="#3C2D12" BorderBrush="#F5B94C" BorderThickness="1" CornerRadius="8" Padding="14">
   <StackPanel>
    <TextBlock Text="PRACTICE / EXPLORATORY" Foreground="#FFD285" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="Recorded historical playback · today's preserved models · simulated fills · CAD 1,000 per account"
     Foreground="#F4E2BF" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="Models may have been trained after the replay dates. These results are exploratory and do not establish future performance."
     Foreground="#F4E2BF" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
    <TextBlock x:Name="ModelTiming" Text="Model dates appear when a practice playback is opened."
     Foreground="#F4E2BF" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <WrapPanel Grid.Row="1" Margin="0,12,0,10" VerticalAlignment="Center">
   <Button x:Name="OpenButton" Content="Open practice playback" Click="Open_Click" Margin="0,0,12,0"/>
   <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False" Margin="0,0,8,0"/>
   <Button x:Name="StepButton" Content="Step" Click="Step_Click" IsEnabled="False" Margin="0,0,12,0"/>
   <ComboBox x:Name="Speed" SelectedIndex="0" Width="155" SelectionChanged="Speed_Changed">
    <ComboBoxItem Content="1 minute / second" Tag="1"/>
    <ComboBoxItem Content="10 minutes / second" Tag="10"/>
    <ComboBoxItem Content="60 minutes / second" Tag="60"/>
   </ComboBox>
   <TextBlock x:Name="ClockText" Text="Open frames.ndjson from a saved practice run." FontSize="16" Margin="16,4,0,0"/>
  </WrapPanel>
  <TextBlock x:Name="StatusText" Grid.Row="2" Text="Playback reads local practice files. Use the Practice runner to generate a run."
   TextWrapping="Wrap" Foreground="#AAB8CC" Margin="0,0,0,10"/>
  <DataGrid x:Name="Accounts" Grid.Row="3" Height="175" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Practice account" Binding="{Binding Account}" Width="1.3*"/>
    <DataGridTextColumn Header="Cash (CAD)" Binding="{Binding Cash, StringFormat=N2}" Width="*"/>
    <DataGridTextColumn Header="Value (CAD)" Binding="{Binding NetAssetValue, StringFormat=N2, TargetNullValue=Unavailable}" Width="*"/>
    <DataGridTextColumn Header="Return" Binding="{Binding Return, StringFormat=P2, TargetNullValue=Unavailable}" Width="*"/>
    <DataGridTextColumn Header="Valuation" Binding="{Binding MarkStatus}" Width="2*"/>
    <DataGridTextColumn Header="Risk state" Binding="{Binding RiskStatus}" Width="1.2*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TabControl Grid.Row="4" Margin="0,12,0,0" Background="#11151B" BorderThickness="0" Padding="0">
   <TabItem Header="Holdings">
    <DataGrid x:Name="Holdings" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Practice account" Binding="{Binding Account}" Width="*"/>
      <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*"/>
      <DataGridTextColumn Header="Shares" Binding="{Binding Shares}" Width="*"/>
      <DataGridTextColumn Header="Average cost" Binding="{Binding AverageCost, StringFormat=N4}" Width="*"/>
      <DataGridTextColumn Header="Last known price" Binding="{Binding LastPrice, StringFormat=N4}" Width="*"/>
      <DataGridTextColumn Header="Price time (Toronto)" Binding="{Binding PriceTime}" Width="1.5*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Daily Delphi lists">
    <DataGrid x:Name="DailyPicks" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Lens" Binding="{Binding Lens}" Width="*"/>
      <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="*"/>
      <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*"/>
      <DataGridCheckBoxColumn Header="Eligible" Binding="{Binding IsEligible}" Width="*"/>
      <DataGridTextColumn Header="Prior close" Binding="{Binding PreviousClose, StringFormat=N4}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Shadow decisions">
    <DataGrid x:Name="Candidates" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Practice account" Binding="{Binding Account}" Width="1.5*"/>
      <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*"/>
      <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="*"/>
      <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
      <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="2*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Pending orders">
    <DataGrid x:Name="Orders" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Practice account" Binding="{Binding Account}" Width="*"/>
      <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*"/>
      <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*"/>
      <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Data gaps"><TextBox x:Name="Warnings" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#11151B" Foreground="#F4F7FB" BorderThickness="0"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>

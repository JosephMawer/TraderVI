<UserControl x:Class="TraderVI.WPF.Views.WealthsimpleAccountPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:TraderVI.WPF.Views"
 Foreground="#E8EEF6">
 <UserControl.Resources>
  <Style x:Key="BrokerCellText" TargetType="TextBlock"><Setter Property="Margin" Value="8,7"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <Border Style="{StaticResource WorkspacePanel}">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="TFSA" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="WEALTHSIMPLE · SELF-DIRECTED" Style="{StaticResource WorkspaceLabel}" Margin="0,4"/></StackPanel>
    <Button Grid.Column="1" Content="Refresh Wealthsimple" Style="{StaticResource WorkspaceButton}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" VerticalAlignment="Center"/>
   </Grid>
   <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelect}" MinHeight="36" Margin="0,14,0,6" HorizontalAlignment="Left" MinWidth="300"/>
   <TextBlock Text="{Binding Status}" Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,18" AutomationProperties.LiveSetting="Polite"/>
   <UniformGrid Columns="3">
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Account value · CAD" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding ValueText, FallbackValue=—}" FontSize="30" Margin="0,5"/></StackPanel>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Cash · CAD" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding CashText, FallbackValue=—}" FontSize="24" Margin="0,5"/></StackPanel>
    <StackPanel><TextBlock Text="Buying power · CAD" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding BuyingPowerText, FallbackValue=—}" FontSize="24" Margin="0,5"/></StackPanel>
   </UniformGrid>
   <UniformGrid Columns="2" Margin="0,14,0,20">
    <StackPanel><TextBlock Text="{Binding ReturnPeriod}" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding ReturnText, FallbackValue=Unavailable}" FontSize="21" Margin="0,5"/><TextBlock Text="{Binding ReturnAsOf}" Style="{StaticResource WorkspaceLabel}"/></StackPanel>
    <StackPanel><TextBlock Text="Net deposits · CAD" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="{Binding NetDepositsText, FallbackValue=—}" FontSize="21" Margin="0,5"/><TextBlock Text="Deposits less withdrawals; not your TFSA contribution room." Style="{StaticResource WorkspaceLabel}"/></StackPanel>
   </UniformGrid>
   <TextBlock Text="Your Wealthsimple holdings" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding HoldingsStatus}" Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,10"/>
   <DataGrid x:Name="HoldingsGrid" ItemsSource="{Binding Holdings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="85" MaxHeight="330" RowHeight="NaN">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" ElementStyle="{StaticResource BrokerCellText}" Width="90"/>
     <DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource BrokerCellText}" Width="*" MinWidth="150"/>
     <DataGridTextColumn Header="Shares / units" Binding="{Binding Quantity, StringFormat=0.########}" ElementStyle="{StaticResource BrokerCellText}" Width="110"/>
     <DataGridTemplateColumn Header="Sell holding" Width="250">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" Margin="5,4" VerticalAlignment="Center">
        <Button Content="Market sell all" Command="{x:Static views:ManualSellCommands.Market}" CommandParameter="{Binding SellSelection}"
         ToolTip="{Binding SellAllToolTip}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource WorkspaceButton}" Padding="9,6" Margin="0,0,7,0"/>
        <Button Content="Limit sell…" Command="{x:Static views:ManualSellCommands.Limit}" CommandParameter="{Binding SellSelection}"
         ToolTip="Open a limit-price ticket. Limit submission is not available yet." Style="{StaticResource WorkspaceButton}" Padding="9,6"/>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="Market value" Binding="{Binding Value}" ElementStyle="{StaticResource BrokerCellText}" Width="140"/>
     <DataGridTextColumn Header="Book value" Binding="{Binding BookValue}" ElementStyle="{StaticResource BrokerCellText}" Width="140"/>
     <DataGridTextColumn Header="Unrealized gain" Binding="{Binding UnrealizedGain}" ElementStyle="{StaticResource BrokerCellText}" Width="140"/>

    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Market sell all sends the entire row's whole-share holding after fresh checks. The broker determines the execution price."
    Style="{StaticResource WorkspaceLabel}" Margin="0,8,0,0"/>
   <DockPanel Margin="0,10,0,0">
    <views:MarketBuyButton DockPanel.Dock="Right" Origin="{Binding SelectedItem.BuyOrigin, ElementName=HoldingsGrid}" Content="Buy more…" Style="{StaticResource WorkspaceButton}" Margin="12,0,0,0" ToolTip="Open a manual ticket to buy additional shares of the selected holding. You choose the share quantity."/>
    <TextBlock Text="{Binding SelectedItem.Symbol, ElementName=HoldingsGrid, StringFormat='Selected holding: {0}', FallbackValue='Select a holding to buy additional shares.'}" Style="{StaticResource WorkspaceLabel}" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="Pending Wealthsimple orders" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
   <TextBlock Text="{Binding OrdersStatus}" Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,10"/>
   <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="65" MaxHeight="220">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="85"/>
     <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="65"/>
     <DataGridTextColumn Header="Submitted shares" Binding="{Binding Quantity, StringFormat=0.########}" Width="145"/>
     <DataGridTextColumn Header="Limit" Binding="{Binding LimitPrice}" Width="120"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Broker balances, holdings and pending orders. Manual buys and sells have saved order histories. Strategy execution and the tracked-position ledger still require reconciliation." Style="{StaticResource WorkspaceLabel}" Margin="0,14,0,0"/>
   <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
    <Button Content="Manual buys…" Command="{x:Static views:ManualBuyCommands.Orders}" Style="{StaticResource WorkspaceButton}" Margin="0,0,10,0"/>
    <Button Content="Manual sells…" Command="{x:Static views:ManualSellCommands.Orders}" Style="{StaticResource WorkspaceButton}"/>
   </StackPanel>
   <Button Content="Review TFSA strategy transition…" Click="ReviewTransition_Click" IsEnabled="{Binding CanRefresh}" Style="{StaticResource WorkspaceButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
  </StackPanel>
 </Border>
</UserControl>

<UserControl x:Class="TraderVI.WPF.Views.WealthsimpleAccountPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:TraderVI.WPF.Views" xmlns:services="clr-namespace:TraderVI.WPF.Services" Foreground="#E8EEF6">
 <UserControl.Resources>
  <Style x:Key="TradingNumber" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="TradingCell" TargetType="TextBlock"><Setter Property="Margin" Value="8,10"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="TradingPeriod" TargetType="RadioButton"><Setter Property="Foreground" Value="#E8EEF6"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <Border Style="{StaticResource WorkspacePanel}" Padding="18,14"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
     <RadioButton Content="Today" GroupName="AccountPerformance" IsChecked="True" Style="{StaticResource TradingPeriod}" Checked="Today_Checked"/>
     <RadioButton Content="Overall" GroupName="AccountPerformance" IsChecked="{Binding ShowOverallPerformance, Mode=TwoWay}" Style="{StaticResource TradingPeriod}"/>
    </StackPanel>
    <TextBlock Text="{Binding PerformanceLabel, FallbackValue=Today performance · CAD}" Style="{StaticResource WorkspaceLabel}" Margin="0,0,18,0"/>
    <TextBlock Grid.Column="1" Text="Account value · CAD" Style="{StaticResource WorkspaceLabel}" Margin="0,0,18,0"/>
    <TextBlock Grid.Column="2" Text="Available cash · CAD" Style="{StaticResource WorkspaceLabel}" Margin="0,0,18,0"/>
    <WrapPanel Grid.Row="1" Margin="0,8,18,0" VerticalAlignment="Top"><TextBlock Text="{Binding PerformanceAmount, FallbackValue=Unavailable}" FontSize="26"/><TextBlock Text="{Binding PerformanceRate}" FontSize="17" Margin="12,7,0,0"/></WrapPanel>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ValueText, FallbackValue=—}" Style="{StaticResource TradingNumber}" FontSize="26" Margin="0,8,18,0" VerticalAlignment="Top"/>
    <Button Grid.Row="1" Grid.Column="3" Content="Refresh Wealthsimple" Style="{StaticResource WorkspaceButton}" IsEnabled="{Binding CanRefresh}" Click="RefreshBroker_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CashText, FallbackValue=—}" Style="{StaticResource TradingNumber}" FontSize="26" Margin="0,8,0,0" VerticalAlignment="Top"/>
    <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding BuyingPowerText, StringFormat='Buying power · {0}'}" Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,0"/>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PerformanceContext}" Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,0"/>
  </Grid></Border>
  <Border Style="{StaticResource WorkspacePanel}" Padding="16,10" Margin="0,12,0,0" DataContext="{Binding Market}">
   <StackPanel>
    <DockPanel><TextBlock Text="Market now" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Status}" Style="{StaticResource WorkspaceLabel}" HorizontalAlignment="Right"/></DockPanel>
    <WrapPanel Margin="0,7,0,0">
     <StackPanel Orientation="Horizontal" Margin="0,0,24,0"><TextBlock Text="TSX Composite"/><TextBlock Text="{Binding Composite.ChangeText}" Foreground="{Binding Composite.Color}" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,24,0"><TextBlock Text="TSX 60"/><TextBlock Text="{Binding Tsx60.ChangeText}" Foreground="{Binding Tsx60.Color}" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel>
     <TextBlock Text="{Binding Breadth}" Margin="0,0,14,0"/><TextBlock Text="{Binding Unchanged}" Style="{StaticResource WorkspaceLabel}"/>
    </WrapPanel>
    <TextBlock Text="Index and sector %: change from previous close" Style="{StaticResource WorkspaceLabel}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding Timing}" Style="{StaticResource WorkspaceLabel}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <StackPanel x:Name="HoldingsTable" Margin="0,18,0,0">
   <TextBlock Text="Your holdings" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding HoldingsStatus}" Style="{StaticResource WorkspaceLabel}" Margin="0,5,0,10"/>
   <DataGrid x:Name="HoldingsGrid" ItemsSource="{Binding Holdings}" SelectedItem="{Binding SelectedHolding, Mode=TwoWay}"
    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
    MinHeight="95" RowHeight="NaN" FontSize="12" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Account holdings, amounts include currency">
    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E8EEF6"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
     <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#233C56"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#9BCAFF"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers>
    </Style></DataGrid.CellStyle>
    <DataGrid.RowStyle><Style TargetType="DataGridRow">
     <Setter Property="Background" Value="#11151B"/><Setter Property="Foreground" Value="#E8EEF6"/>
     <Setter Property="ContextMenu"><Setter.Value>
      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
       <ContextMenu.ItemContainerStyle><Style TargetType="MenuItem">
        <Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
       </Style></ContextMenu.ItemContainerStyle>
       <MenuItem Header="{Binding Symbol}" HeaderStringFormat="Buy more {0}…" Command="{x:Static views:ManualBuyCommands.Open}" CommandParameter="{Binding BuyOrigin}"/>
       <MenuItem Header="{Binding Symbol}" HeaderStringFormat="Sell all {0} at market" Command="{x:Static views:ManualSellCommands.Market}" CommandParameter="{Binding SellSelection}" ToolTip="{Binding SellAllToolTip}" ToolTipService.ShowOnDisabled="True"/>
       <MenuItem Header="Limit sell preview…" Command="{x:Static views:ManualSellCommands.Limit}" CommandParameter="{Binding SellSelection}"/>
      </ContextMenu>
     </Setter.Value></Setter>
     <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#233C56"/><Setter Property="Foreground" Value="#E8EEF6"/></Trigger></Style.Triggers>
    </Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Ticker" Binding="{Binding Symbol}" ElementStyle="{StaticResource TradingCell}" Width="70"/>
     <DataGridTextColumn Header="Company name" Binding="{Binding Name}" ElementStyle="{StaticResource TradingCell}" Width="*" MinWidth="145"/>
     <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="145">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TradingCell}">
       <Setter Property="ToolTip" Value="{Binding SectorDetails}"/>
      </Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Shares held" Binding="{Binding Quantity, StringFormat=0.########}" ElementStyle="{StaticResource TradingCell}" Width="95"/>
     <DataGridTextColumn Header="Avg. cost/share" Binding="{Binding AverageCost}" ElementStyle="{StaticResource TradingCell}" Width="115"/>
     <DataGridTextColumn Header="Current price/share" Binding="{Binding CurrentPricePerShare}" Width="140">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TradingCell}">
       <Setter Property="ToolTip" Value="Position value divided by shares held in the latest account snapshot. Wealthsimple does not supply a quote time here."/>
      </Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Position value" Binding="{Binding Value}" Width="120">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TradingCell}">
       <Setter Property="ToolTip" Value="{Binding ValueContext}"/>
      </Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Gain/loss on cost" Binding="{Binding GainOnCost}" SortMemberPath="GainAmount" Width="128">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TradingCell}">
       <Setter Property="Foreground" Value="{Binding GainColor}"/>
      </Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Return on cost" Binding="{Binding GainRate, StringFormat=P2, TargetNullValue=—}" Width="112">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TradingCell}">
       <Setter Property="Foreground" Value="{Binding ReturnColor}"/>
      </Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTemplateColumn Header="Strategy status" SortMemberPath="StrategyDecision.Status" Width="125">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBlock Text="{Binding StrategyDecision.Status}" Style="{StaticResource TradingCell}">
        <TextBlock.ToolTip><TextBlock MaxWidth="380" TextWrapping="Wrap"><TextBlock.Text>
        <MultiBinding StringFormat="{}{0}&#10;&#10;Next step: {1}&#10;{2}">
         <Binding Path="StrategyDecision.Reason"/><Binding Path="StrategyDecision.NextStep"/><Binding Path="StrategyDecision.Context"/>
        </MultiBinding>
        </TextBlock.Text></TextBlock></TextBlock.ToolTip>
       </TextBlock>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Right-click a holding or press Shift+F10 for trade options. Hover over its strategy status for details." Style="{StaticResource WorkspaceLabel}" Margin="0,6,0,0"/>
   <TextBlock Text="{Binding Status}" Style="{StaticResource WorkspaceLabel}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <Grid Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource WorkspacePanel}" Padding="16,12" DataContext="{Binding Market}">
    <StackPanel>
     <TextBlock Text="TSX sectors" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Sector indices · strongest to weakest" Style="{StaticResource WorkspaceLabel}" Margin="0,4,0,8"/>
     <ItemsControl ItemsSource="{Binding Sectors}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0"/>
       <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource WorkspacePanel}" Padding="16,12" VerticalAlignment="Top">
    <StackPanel>
     <TextBlock Text="Your sector exposure" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding ExposureContext}" Style="{StaticResource WorkspaceLabel}" Margin="0,4,0,10" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding SectorExposure}"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,0,13">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Sector}" TextWrapping="Wrap" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding ShareText}" FontWeight="SemiBold"/>
       </Grid>
       <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" Foreground="#83BFFF" Background="#263442" BorderThickness="0" Margin="0,5"/>
       <TextBlock Text="{Binding Amount}" Style="{StaticResource WorkspaceLabel}" FontSize="11"/>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border>
  </Grid>
  <WrapPanel Margin="0,16,0,18" VerticalAlignment="Center">
   <TextBlock Text="Approved strategy · " Style="{StaticResource WorkspaceLabel}" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding ManagedStrategy.StrategyName, TargetNullValue=No approved strategy loaded}" VerticalAlignment="Center"
    ToolTip="{Binding ManagedStrategy.StrategyDetails}" ToolTipService.ShowDuration="30000"/>
   <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"><Hyperlink Click="ViewStrategy_Click" Foreground="#83BFFF"
    ToolTip="Open the approved strategy's source in Portfolios. Review strategy changes there.">View strategy</Hyperlink></TextBlock>
  </WrapPanel>
 </StackPanel>
</UserControl>

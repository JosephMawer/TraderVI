<Window x:Class="TraderVI.WPF.PaperDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TraderVI · Paper Monitor"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Background="#11151B" Foreground="#F4F7FB"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202836"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E3949"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA8BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5FA8FF"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="#55D68B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F5B94C"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#171D25"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08111D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TraderVI Paper Monitor" FontSize="28" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding MarketStatus}" Foreground="{StaticResource PositiveBrush}"/>
                    <TextBlock Text="  ·  Next poll " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding NextPollText}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding MonitorStatus}" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#183B2B" CornerRadius="12" Padding="12,7" Margin="0,0,12,0">
                    <TextBlock Text="GHOST EXITS ON · NO BROKER" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold"/>
                </Border>
                <Button x:Name="PollNowButton" Content="Poll now · TMX + SQL" Click="PollNowButton_Click"
                        IsEnabled="{Binding CanPollNow}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Open positions"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenPositionCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Closed paper trades"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding ClosedPositionCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Realized paper P/L"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding RealizedPnL, StringFormat={}{0:C2}}"/></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Latest durable receipt"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding LastReceiptText}" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Paper positions" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}">
                        <Run Text="Open unrealized: "/><Run Text="{Binding UnrealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/>
                    </TextBlock>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Positions}" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Latest / exit" Binding="{Binding CurrentOrExitPrice, StringFormat={}{0:C3}}" Width="105"/>
                        <DataGridTextColumn Header="P/L" Binding="{Binding PnL, StringFormat={}{0:C2}}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="P/L %" Binding="{Binding PnLPct, StringFormat={}{0:P2}}" Width="82"/>
                        <DataGridTextColumn Header="High water" Binding="{Binding HighWaterMark, StringFormat={}{0:C3}}" Width="100"/>
                        <DataGridTextColumn Header="Trail" Binding="{Binding TrailingStopPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Directive" Binding="{Binding Directive}" Width="*"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdatedLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Trade history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="68"/>
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="58"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C3}}" Width="78"/>
                            <DataGridTextColumn Header="Realized" Binding="{Binding RealizedPnL, StringFormat={}{0:C2}}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Durable poll history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Polls}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding TimeLocal, StringFormat={}{0:HH:mm:ss}}" Width="78"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="65"/>
                            <DataGridTextColumn Header="Bar" Binding="{Binding IntervalMinutes, StringFormat={}{0}m}" Width="48"/>
                            <DataGridTextColumn Header="Audit" Binding="{Binding AuditState}" Width="*"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewBars}" Width="45"/>
                            <DataGridTextColumn Header="Latest event" Binding="{Binding LatestEvent}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12,8">
            <Grid>
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding LatestEventText}" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" Text="Keep this app open · TMX delayed · no broker"/>
            </Grid>
        </Border>
    </Grid>
</Window>

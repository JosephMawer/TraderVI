<Window x:Class="TraderVI.WPF.PaperDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TraderVI.WPF.Views"
        Title="TraderVI"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Background="#11151B" Foreground="#F4F7FB"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202836"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E3949"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA8BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5FA8FF"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="#55D68B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F5B94C"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#171D25"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08111D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A2029"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0" Padding="20,10">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#08111D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem x:Name="PaperTradingTab" Header="Trading">
       <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TraderVI Trading Monitor" FontSize="28" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding MarketStatus}" Foreground="{StaticResource PositiveBrush}"/>
                    <TextBlock Text="  ·  Next poll " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding NextPollText}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding MonitorStatus}" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#183B2B" CornerRadius="12" Padding="12,7" Margin="0,0,12,0">
                    <TextBlock Text="GHOST AUTO-EXITS · REAL SIGNALS ONLY · NO BROKER" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold"/>
                </Border>
                <Button x:Name="PollNowButton" Content="Poll now · TMX + SQL" Click="PollNowButton_Click"
                        IsEnabled="{Binding CanPollNow}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Open ghost"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenGhostCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Open real"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenRealCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ghost unrealized"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding GhostUnrealizedPnL, StringFormat={}{0:C2}}"/></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Real unrealized"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding RealUnrealizedPnL, StringFormat={}{0:C2}}"/></StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ghost / real realized"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding GhostRealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/><Run Text=" / "/><Run Text="{Binding RealRealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/></TextBlock></StackPanel>
            </Border>
            <Border Grid.Column="10" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Latest durable receipt"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding LastReceiptText}" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tracked positions" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExecutionSchemaStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}">
                        <Run Text="Ghost / real unrealized: "/><Run Text="{Binding GhostUnrealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/><Run Text=" / "/><Run Text="{Binding RealUnrealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/>
                    </TextBlock>
                </Grid>
                <DataGrid x:Name="PositionsGrid" Grid.Row="1" ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding SelectedPosition}" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="88"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel}" Width="72"/>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Latest / exit" Binding="{Binding CurrentOrExitPrice, StringFormat={}{0:C3}}" Width="105"/>
                        <DataGridTextColumn Header="P/L" Binding="{Binding PnL, StringFormat={}{0:C2}}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="P/L %" Binding="{Binding PnLPct, StringFormat={}{0:P2}}" Width="82"/>
                        <DataGridTextColumn Header="High water" Binding="{Binding HighWaterMark, StringFormat={}{0:C3}}" Width="100"/>
                        <DataGridTextColumn Header="Trail" Binding="{Binding TrailingStopPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Directive" Binding="{Binding Directive}" Width="*" MinWidth="170"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdatedLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Real account" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding RealAccountLabel, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" Padding="7,5"/>
                    <Button x:Name="MarkRealButton" Grid.Column="2" Content="Mark selected as REAL"
                            Click="MarkRealButton_Click" IsEnabled="{Binding CanMarkSelectedAsReal}"
                            Margin="10,0,0,0" Padding="12,6"/>
                    <TextBlock Grid.Column="4" Text="Actual sell fill" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Grid.Column="5" Text="{Binding RealExitFillPrice, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" Padding="7,5"/>
                    <Button x:Name="RecordRealExitButton" Grid.Column="6" Content="Record REAL exit"
                            Click="RecordRealExitButton_Click" IsEnabled="{Binding CanRecordSelectedRealExit}"
                            Margin="10,0,0,0" Padding="12,6" Background="{StaticResource WarningBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Trade history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel}" Width="65"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="68"/>
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="58"/>
                            <DataGridTextColumn Header="Recorded fill" Binding="{Binding Price, StringFormat={}{0:C3}}" Width="96"/>
                            <DataGridTextColumn Header="Realized" Binding="{Binding RealizedPnL, StringFormat={}{0:C2}}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Durable poll history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Polls}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding TimeLocal, StringFormat={}{0:HH:mm:ss}}" Width="78"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="65"/>
                            <DataGridTextColumn Header="Bar" Binding="{Binding IntervalMinutes, StringFormat={}{0}m}" Width="48"/>
                            <DataGridTextColumn Header="Audit" Binding="{Binding AuditState}" Width="*"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewBars}" Width="45"/>
                            <DataGridTextColumn Header="Latest event" Binding="{Binding LatestEvent}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12,8">
            <Grid>
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding LatestEventText}" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" Text="Keep this app open · TMX delayed · real fills manual · no broker"/>
            </Grid>
        </Border>
       </Grid>
      </TabItem>
      <TabItem Header="Portfolios">
        <views:PortfoliosView x:Name="PortfoliosTabView"/>
      </TabItem>
      <TabItem Header="Data Audit">
        <views:DataAuditView/>
      </TabItem>
      <TabItem Header="Delphi">
        <views:DelphiView x:Name="DelphiTabView"/>
      </TabItem>
      <TabItem Header="Delphi Live">
        <views:DelphiLiveView x:Name="DelphiLiveTabView"/>
      </TabItem>
      <TabItem Header="Scorecards">
        <views:ScorecardsView/>
      </TabItem>
      <TabItem Header="Project Docs">
        <views:ProjectDocsView/>
      </TabItem>
    </TabControl>
</Window>

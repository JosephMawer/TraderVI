<Window x:Class="TraderVI.WPF.PaperDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TraderVI.WPF.Views"
        xmlns:services="clr-namespace:TraderVI.WPF.Services"
        Title="TraderVI"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Background="#11151B" Foreground="#F4F7FB"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A2029"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202836"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E3949"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA8BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5FA8FF"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="#55D68B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F5B94C"/>

        <!-- All dashboard pages inherit dark disclosure panels unless they supply a local style. -->
        <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#171D25"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08111D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#253245"/>
                                <Setter Property="Foreground" Value="#A9B9CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="CaretBrush" Value="#EAF0F8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A2029"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0" Padding="20,10">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center"
                                              TextElement.Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#08111D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="#1A2029" Padding="10,3" BorderBrush="#2E3949" BorderThickness="0,1,0,0"
              AutomationProperties.Name="System status">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip, ElementName=EngineOverviewText}">
            <TextBlock Text="Engine" Style="{StaticResource StatLabel}" Margin="0,0,5,0"/>
            <TextBlock x:Name="EngineOverviewText" Text="Checking…" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <DockPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip, ElementName=CollectorOverviewText}">
            <TextBlock Text="Collector" Style="{StaticResource StatLabel}" Margin="0,0,5,0"/>
            <TextBlock x:Name="CollectorOverviewText" Text="Checking…" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <views:ExecutionReadinessView Grid.Column="2" x:Name="HeaderExecutionReadiness" Compact="True" Heading="Execution" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <DockPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip, ElementName=HistoryOverviewText}">
            <TextBlock Text="History" Style="{StaticResource StatLabel}" Margin="0,0,5,0"/>
            <TextBlock x:Name="HistoryOverviewText" Text="Awaiting status" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip, ElementName=DailyPrepText}">
            <TextBlock Text="Daily prep" Style="{StaticResource StatLabel}" Margin="0,0,5,0"/>
            <TextBlock x:Name="DailyPrepText" Text="Checking…" FontWeight="SemiBold"/>
          </StackPanel>
          <Button x:Name="WealthsimpleStatus" Grid.Column="5" Margin="0,0,8,0" Padding="7,2"
                  Style="{StaticResource WorkspaceButton}" Command="{x:Static views:WorkspaceNavigationState.OpenWealthsimple}"
                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}">
            <AutomationProperties.Name>
              <MultiBinding StringFormat="{}{0}&#10;{1}">
                <Binding Path="AccessibleStatus"/>
                <Binding ElementName="MainAccountContent" Path="Content.DataContext.FooterHoldingsDetail"/>
              </MultiBinding>
            </AutomationProperties.Name>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding IndicatorColor, FallbackValue=#FF747D}" VerticalAlignment="Center"/>
              <TextBlock Text="Wealthsimple" Margin="5,0" FontSize="12"/>
              <TextBlock Text="{Binding Status, FallbackValue=Disconnected}" FontSize="12" FontWeight="SemiBold" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding ElementName=MainAccountContent, Path=Content.DataContext.FooterHoldingsFlag}" FontSize="12" FontWeight="SemiBold" Foreground="#F5B94C"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="6" Content="Open Engine →" Click="OpenEngine_Click" Padding="8,3" FontSize="12"/>
        </Grid>
      </Border>
    <TabControl x:Name="MainTabs" Style="{StaticResource WorkspaceNavigation}" Background="Transparent" Foreground="#F4F7FB" BorderThickness="0" Padding="0">
      <TabItem x:Name="PaperTradingTab" Header="Trading" views:WorkspaceNavigationState.Icon="&#xE80F;">
       <!-- Nested tabs otherwise pick up the application's MaterialDesign Light surface and text. -->
       <TabControl x:Name="TradingSections" Background="#11151B" Foreground="#F4F7FB" BorderThickness="0" Padding="0">
        <TabItem Header="Main account">
         <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#11151B"><ContentControl x:Name="MainAccountContent" Margin="18" HorizontalContentAlignment="Stretch"/></ScrollViewer>
        </TabItem>
        <TabItem Header="Recorded trades &amp; monitor">
       <Grid Margin="22" TextElement.Foreground="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TraderVI Trading Monitor" FontSize="28" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding MarketStatus}" Foreground="{StaticResource PositiveBrush}"/>
                    <TextBlock Text="  ·  Next poll " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding NextPollText}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding MonitorStatus}" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#183B2B" CornerRadius="12" Padding="12,7" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ExecutionPolicyBanner}" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold"/>
                </Border>
                <Button Content="Settings…" Click="TradingSettings_Click" Margin="0,0,8,0"/>
                <Button x:Name="PollNowButton" Content="Poll now · TMX + SQL" Click="PollNowButton_Click"
                        IsEnabled="{Binding CanPollNow}"/>
            </StackPanel>
            <views:SystemControlBar Grid.Row="1" Grid.ColumnSpan="2" SystemKey="TrackedPositions"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Open ghost"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenGhostCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Open real"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenRealCount}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ghost unrealized"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding GhostUnrealizedPnL, StringFormat={}{0:C2}}"/></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Real unrealized"/><TextBlock Style="{StaticResource StatValue}" Text="{Binding RealUnrealizedPnL, StringFormat={}{0:C2}}"/></StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ghost / real realized"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding GhostRealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/><Run Text=" / "/><Run Text="{Binding RealRealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/></TextBlock></StackPanel>
            </Border>
            <Border Grid.Column="10" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Latest durable receipt"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding LastReceiptText}" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tracked positions" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExecutionSchemaStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}">
                        <Run Text="Ghost / real unrealized: "/><Run Text="{Binding GhostUnrealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/><Run Text=" / "/><Run Text="{Binding RealUnrealizedPnL, Mode=OneWay, StringFormat={}{0:C2}}"/>
                    </TextBlock>
                </Grid>
                <DataGrid x:Name="PositionsGrid" Grid.Row="1" ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding SelectedPosition}" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Action" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <Button Content="{Binding ExitActionLabel}" Click="ExitPosition_Click" IsEnabled="{Binding IsActive}" Padding="8,4"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="88"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel}" Width="72"/>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Latest / exit" Binding="{Binding CurrentOrExitPrice, StringFormat={}{0:C3}}" Width="105"/>
                        <DataGridTextColumn Header="P/L" Binding="{Binding PnL, StringFormat={}{0:C2}}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="P/L %" Binding="{Binding PnLPct, StringFormat={}{0:P2}}" Width="82"/>
                        <DataGridTextColumn Header="High water" Binding="{Binding HighWaterMark, StringFormat={}{0:C3}}" Width="100"/>
                        <DataGridTextColumn Header="Trail" Binding="{Binding TrailingStopPrice, StringFormat={}{0:C3}}" Width="90"/>
                        <DataGridTextColumn Header="Directive" Binding="{Binding Directive}" Width="*" MinWidth="170"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdatedLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Real account" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding RealAccountLabel, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" Padding="7,5"/>
                    <Button x:Name="MarkRealButton" Grid.Column="2" Content="Mark selected as REAL"
                            Click="MarkRealButton_Click" IsEnabled="{Binding CanMarkSelectedAsReal}"
                            Margin="10,0,0,0" Padding="12,6"/>
                    <TextBlock Grid.Column="4" Text="Actual sell fill" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Grid.Column="5" Text="{Binding RealExitFillPrice, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" Padding="7,5"/>
                    <Button x:Name="RecordRealExitButton" Grid.Column="6" Content="Record REAL exit"
                            Click="RecordRealExitButton_Click" IsEnabled="{Binding CanRecordSelectedRealExit}"
                            Margin="10,0,0,0" Padding="12,6" Background="{StaticResource WarningBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Trade history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat={}{0:MMM d HH:mm:ss}}" Width="125"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel}" Width="65"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="68"/>
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="58"/>
                            <DataGridTextColumn Header="Recorded fill" Binding="{Binding Price, StringFormat={}{0:C3}}" Width="96"/>
                            <DataGridTextColumn Header="Realized" Binding="{Binding RealizedPnL, StringFormat={}{0:C2}}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PnLBrush}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Durable poll history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Polls}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding TimeLocal, StringFormat={}{0:HH:mm:ss}}" Width="78"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="65"/>
                            <DataGridTextColumn Header="Bar" Binding="{Binding IntervalMinutes, StringFormat={}{0}m}" Width="48"/>
                            <DataGridTextColumn Header="Audit" Binding="{Binding AuditState}" Width="*"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewBars}" Width="45"/>
                            <DataGridTextColumn Header="Latest event" Binding="{Binding LatestEvent}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="12,8">
            <Grid>
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding LatestEventText}" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" Text="Keep this app open · TMX delayed · real fills manual · no broker"/>
            </Grid>
        </Border>
       </Grid>
        </TabItem>
        <TabItem x:Name="AccountToolsTab" Header="Account tools"><views:TradingRecommendationsView x:Name="TradingRecommendationsTabView"/></TabItem>
       </TabControl>
      </TabItem>
      <TabItem Header="Portfolios" views:WorkspaceNavigationState.Icon="&#xE821;">
        <views:PortfoliosView x:Name="PortfoliosTabView"/>
      </TabItem>
      <TabItem Header="Delphi" views:WorkspaceNavigationState.Icon="&#xE721;">
        <views:DelphiView x:Name="DelphiTabView"/>
      </TabItem>
      <TabItem Header="Delphi Live" views:WorkspaceNavigationState.Icon="&#xE95E;">
        <views:DelphiLiveView x:Name="DelphiLiveTabView"/>
      </TabItem>
      <TabItem Header="Practice" views:WorkspaceNavigationState.Icon="&#xE768;">
        <views:PracticeView/>
      </TabItem>
      <TabItem Header="Scorecards" views:WorkspaceNavigationState.Icon="&#xE9D2;">
        <views:ScorecardsView/>
      </TabItem>
      <TabItem Header="Engine" x:Name="EngineTab" views:WorkspaceNavigationState.Icon="&#xE7F4;">
        <TabControl x:Name="EngineSections" SelectedIndex="0" Background="Transparent" BorderThickness="0" Foreground="#E8EEF6">
          <TabItem Header="Health &amp; issues">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24" MaxWidth="1050">
                <TextBlock Text="Health &amp; issues" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="HealthSummaryText" Text="Reading system status…" FontSize="16" Margin="0,8,0,12" TextWrapping="Wrap"/>
                <WrapPanel><Button x:Name="HealthRefreshButton" Content="Refresh status" Click="RefreshHealth_Click" Margin="0,0,10,8"/>
                  <Button Content="Copy diagnostic snapshot" Click="CopyHealth_Click" Margin="0,0,10,8" ToolTip="Copy the same issue records as structured JSON for investigation. Copying does not execute any action."/></WrapPanel>
                <TextBlock x:Name="HealthCopyStatus" Foreground="#ADBBCC" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="Restrictions" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock x:Name="HealthRestrictionsEmpty" Foreground="#ADBBCC" TextWrapping="Wrap"/>
                <views:EngineHealthList x:Name="HealthRestrictions"/>
                <TextBlock Text="Warnings &amp; verification gaps" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBlock x:Name="HealthWarningsEmpty" Foreground="#ADBBCC" TextWrapping="Wrap"/>
                <views:EngineHealthList x:Name="HealthWarnings"/>
                <TextBlock Text="Current status, waits &amp; operator settings" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <views:EngineHealthList x:Name="HealthWaiting"/>
                <TextBlock Text="What this page covers" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,5"/>
                <TextBlock x:Name="HealthCoverageText" Foreground="#ADBBCC" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Controls">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24" MaxWidth="1050">
                <TextBlock Text="Engine controls" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Closing the dashboard leaves the engine running. Stopping the engine does not stop the separate collector." Foreground="#ADBBCC" TextWrapping="Wrap" Margin="0,6,0,20"/>
            <views:ExecutionReadinessView x:Name="EngineExecutionReadiness" Margin="0,0,0,20"/>
            <TextBlock Text="Trading engine" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="EngineStatusText" Text="Waiting for engine status." TextWrapping="Wrap" Margin="0,6,0,10"/>
            <WrapPanel>
              <Button x:Name="StartEngineButton" Content="Start engine" Click="StartEngine_Click" IsEnabled="False" Margin="0,0,10,8"/>
              <Button x:Name="StopEngineButton" Content="Stop engine" Click="StopEngine_Click" IsEnabled="False" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="Stopping the engine stops automatic protection after admitted work finishes. Existing broker orders and history remain."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <TextBlock Text="Real execution" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Review setup and permissions, or stop the Real execution host separately." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <StackPanel x:Name="EngineAccountControls">
              <WrapPanel>
                <Button Content="Execution setup…" Command="{x:Static services:BrokerExecutionHostCommands.Open}" CommandParameter="{Binding SelectedAccount}" Margin="0,0,10,8"/>
                <Button Content="Stop execution host" Command="{x:Static services:BrokerExecutionHostCommands.Stop}" Margin="0,0,10,8"/>
                <Button Content="Review switch…" Click="ReviewEngineSwitch_Click" IsEnabled="{Binding CanRefresh, FallbackValue=False}" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock Text="Connect and select the account in Trading to make setup and strategy review available." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CanRefresh}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="History">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24" MaxWidth="1050">
                <TextBlock Text="History &amp; recovery evidence" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Retained audit receipts and engine notices. Older failed receipts remain here after later success. This is not a complete incident-resolution log." Foreground="#ADBBCC" TextWrapping="Wrap" Margin="0,6,0,14"/>
                <TextBlock x:Name="HistoryDetailText" Text="Awaiting history status." TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="History checks and recovery…" Click="HistoryChecks_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock Text="Verification and hold clearance use the existing review controls. Reading this page does not run recovery or clear anything." Foreground="#ADBBCC" TextWrapping="Wrap"/>
                <TextBlock x:Name="HealthHistoryEmpty" Text="No history receipts have been loaded." Foreground="#ADBBCC" Margin="0,12,0,0"/>
                <views:EngineHealthList x:Name="HealthHistory"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>
      <TabItem Header="Settings" x:Name="SettingsTab" views:WorkspaceNavigationState.Icon="&#xE713;">
        <views:GlobalSettingsView x:Name="SettingsTabView"/>
      </TabItem>
    </TabControl>
    </DockPanel>
</Window>

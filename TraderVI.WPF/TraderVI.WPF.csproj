<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\TraderVI.Engine\TraderVI.Engine.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Tools\Wealthsimple.EdgeBridge\Wealthsimple.EdgeBridge.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyIndependentEngineHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\TraderVI.Engine\TraderVI.Engine.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="_EngineTarget" />
    </MSBuild>
    <ItemGroup>
      <_EngineFiles Include="@(_EngineTarget)" />
      <_EngineFiles Include="@(_EngineTarget->'%(RootDir)%(Directory)%(Filename).exe')" />
      <_EngineFiles Include="@(_EngineTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <_EngineFiles Include="@(_EngineTarget->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEdgeLoginHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Tools\Wealthsimple.EdgeBridge\Wealthsimple.EdgeBridge.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="_EdgeBridgeTarget" />
    </MSBuild>
    <ItemGroup>
      <_EdgeBridgeFiles Include="@(_EdgeBridgeTarget)" />
      <_EdgeBridgeFiles Include="@(_EdgeBridgeTarget->'%(RootDir)%(Directory)%(Filename).exe')" />
      <_EdgeBridgeFiles Include="@(_EdgeBridgeTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <_EdgeBridgeFiles Include="@(_EdgeBridgeTarget->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_EdgeBridgeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CompactRestartCandidate)' == 'true'">
    <DefineConstants>$(DefineConstants);COMPACT_RESTART_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CompactRestartCandidate)' != 'true'">
    <Compile Remove="IsolatedCompactHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The colocated dashboard omits assemblies supplied by this installed shared runtime.
         The headless engine must declare the same runtime to resolve its SQL/DPAPI dependencies. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <Compile Include="..\TraderVI.WPF\Services\WindowsWealthsimpleSessionStore.cs" Link="Windows\WindowsWealthsimpleSessionStore.cs" />
    <Compile Include="..\TraderVI.WPF\Services\WindowsManualBuyProtector.cs" Link="Windows\WindowsManualBuyProtector.cs" />
  </ItemGroup>
</Project>

{
  "schemaVersion": 3,
  "task": {
    "name": "TraderVI Nightly",
    "localTime": "00:30",
    "daysOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "executionTimeLimitHours": 10
  },
  "build": {
    "configuration": "Release",
    "timeoutMinutes": 30,
    "restoreDependencies": true,
    "captureAttempts": 3,
    "restoreAttempts": 3,
    "retryDelaySeconds": 10,
    "restoreTimeoutMinutes": 5
  },
  "stages": [
    {
      "name": "Hermes",
      "project": "Hermes/Hermes.csproj",
      "entryAssembly": "Hermes/bin/Release/net10.0/Hermes.dll",
      "timeoutMinutes": 360,
      "successExitCodes": [0],
      "attentionExitCodes": [],
      "failurePatterns": [
        "Failed:\\s*[1-9]\\d*",
        "collection failed:"
      ],
      "attentionPatterns": ["HermesSymbolUnavailable:"],
      "continueAfterFailure": false
    },
    {
      "name": "DataAudit",
      "project": "DataAudit/DataAudit.csproj",
      "entryAssembly": "DataAudit/bin/Release/net10.0/DataAudit.dll",
      "arguments": ["--json"],
      "timeoutMinutes": 30,
      "successExitCodes": [0],
      "attentionExitCodes": [1, 2],
      "failurePatterns": [],
      "attentionPatterns": [],
      "continueAfterFailure": true
    },
    {
      "name": "Delphi",
      "project": "Delphi/Delphi.csproj",
      "entryAssembly": "Delphi/bin/Release/net10.0/Delphi.dll",
      "timeoutMinutes": 120,
      "successExitCodes": [0],
      "attentionExitCodes": [],
      "failurePatterns": [
        "audit=Invalid"
      ],
      "attentionPatterns": [
        "audit=Degraded"
      ],
      "continueAfterFailure": true
    },
    {
      "name": "Athena",
      "project": "Athena/Athena.csproj",
      "entryAssembly": "Athena/bin/Release/net10.0/Athena.dll",
      "timeoutMinutes": 120,
      "successExitCodes": [0],
      "attentionExitCodes": [2],
      "failurePatterns": [],
      "attentionPatterns": [],
      "continueAfterFailure": false
    }
  ]
}

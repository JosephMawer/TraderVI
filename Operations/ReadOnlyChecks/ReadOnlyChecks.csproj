<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TraderVI.ReadOnlyChecks</AssemblyName>
    <ScriptDomPath Condition="'$(ScriptDomPath)' == ''">C:\Program Files\Microsoft Visual Studio\18\Insiders\Common7\IDE\Extensions\Microsoft\SQLDB\DAC\Microsoft.SqlServer.TransactSql.ScriptDom.dll</ScriptDomPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom">
      <HintPath>$(ScriptDomPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>

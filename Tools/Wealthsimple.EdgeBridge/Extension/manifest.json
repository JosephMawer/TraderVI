{
  "manifest_version": 3,
  "name": "TraderVI Wealthsimple sign-in",
  "version": "1.0.0",
  "description": "Hand an explicitly started Wealthsimple login back to TraderVI.",
  "key": "",
  "permissions": ["activeTab", "debugger", "nativeMessaging", "alarms"],
  "action": { "default_title": "Connect this Wealthsimple login to TraderVI", "default_popup": "popup.html" },
  "background": { "service_worker": "background.mjs", "type": "module" }
}
